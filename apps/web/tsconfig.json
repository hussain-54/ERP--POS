{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vitest/globals"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@electronic-erp/contracts": ["../../packages/contracts/src/index.ts"],
      "@electronic-erp/domain": ["../../packages/domain/src/index.ts"],
      "@electronic-erp/db": ["../../packages/db/src/index.ts"],
      "@electronic-erp/hardware": ["../../packages/hardware/src/index.ts"],
      "@electronic-erp/offline": ["../../packages/offline/src/index.ts"],
      "@electronic-erp/ui": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
