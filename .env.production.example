# Production — dedicated project + secrets manager. Never commit real values.
VITE_SUPABASE_URL=https://your-prod-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-prod-anon-or-publishable-key
VITE_API_URL=https://api.example.com

APP_ENV=production
NODE_ENV=production
LOG_LEVEL=info
SUPABASE_URL=https://your-prod-project.supabase.co
SUPABASE_ANON_KEY=your-prod-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-prod-service-role-key
API_PORT=4000
API_CORS_ORIGIN=https://app.example.com

# Inject via secret store / CI — never hardcode in source
# PAYMENT_GATEWAY_SECRET=
# ENCRYPTION_KEY=
