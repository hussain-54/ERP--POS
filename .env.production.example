# Production — dedicated project + secrets manager. Never commit real values.
VITE_SUPABASE_URL=https://your-prod-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-prod-anon-or-publishable-key
# Optional alias (same value as anon key):
# VITE_SUPABASE_PUBLISHABLE_KEY=your-prod-anon-or-publishable-key
#
# On Vercel (web + serverless API co-hosted): leave VITE_API_URL unset / empty.
# Do NOT set http://localhost:4000 in Production — the build ignores localhost and uses same-origin /api.
# VITE_API_URL=

APP_ENV=production
NODE_ENV=production
LOG_LEVEL=info
SUPABASE_URL=https://your-prod-project.supabase.co
SUPABASE_ANON_KEY=your-prod-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-prod-service-role-key
API_PORT=4000
# PORT is accepted automatically on Render/Railway/Fly when API_PORT is unset
# On Vercel this is optional (CORS allows *.vercel.app). For a custom domain set:
API_CORS_ORIGIN=https://your-app.vercel.app

# Inject via secret store / CI — never hardcode in source
# PAYMENT_GATEWAY_SECRET=
# ENCRYPTION_KEY=
