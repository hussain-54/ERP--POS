# Staging — use a dedicated Supabase project. No production data.
VITE_SUPABASE_URL=https://your-staging-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-staging-anon-or-publishable-key
VITE_API_URL=https://api.staging.example.com

APP_ENV=staging
NODE_ENV=production
LOG_LEVEL=info
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_ANON_KEY=your-staging-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key
API_PORT=4000
API_CORS_ORIGIN=https://app.staging.example.com

