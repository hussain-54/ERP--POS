# =============================================================================
# Electronic ERP — environment template (NO REAL SECRETS)
# Copy to `.env` locally. Prefer also:
#   .env.development.example → .env.development
#   .env.staging.example     → .env.staging
#   .env.production.example  → .env.production
# =============================================================================

# --- Frontend (Vite / browser) — publishable/anon only ---
VITE_SUPABASE_URL=
# Project uses VITE_SUPABASE_ANON_KEY (Supabase "anon" / publishable key)
VITE_SUPABASE_ANON_KEY=
# Alias accepted by apps/web (same value as anon / publishable key)
# VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_URL=

# --- Backend (Node API) — server only; never put these in Vite/React ---
APP_ENV=
NODE_ENV=
LOG_LEVEL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
API_PORT=
# PaaS hosts (Render/Railway/Fly) inject PORT — API accepts PORT when API_PORT unset
# PORT=
API_CORS_ORIGIN=

# --- Electron / desktop (online shell; optional) ---
# Update feed for packaged builds (electron-updater). Not required for local desktop:dev.
# ELECTRON_UPDATE_URL=https://updates.example.com/electronic-erp-pos/
# Fail readiness if renderer dist is missing (CI / packaging checks)
# DESKTOP_REQUIRE_DIST=1

# --- Production secrets (inject via host / secret manager; never commit) ---
# PAYMENT_GATEWAY_SECRET=
# ENCRYPTION_KEY=
# SMTP_PASSWORD=
# OAUTH_CLIENT_SECRET=
