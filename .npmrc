# Cross-platform npm config (must work on Linux/Vercel and Windows).
# Do NOT set script-shell=cmd.exe — that breaks esbuild postinstall on Linux
# (ENOENT spawn cmd.exe) when Vercel runs npm install.
fund=false
audit=false
engine-strict=false
install-links=false
# Ensure native package install scripts (esbuild) still run on npm 10+/Node 24.
ignore-scripts=false
