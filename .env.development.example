# Public (Vite / browser) — anon / publishable key only. NEVER put service role here.
VITE_SUPABASE_URL=https://your-dev-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-dev-anon-or-publishable-key
VITE_API_URL=http://localhost:4000

# API / server only
APP_ENV=development
NODE_ENV=development
LOG_LEVEL=debug
SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_ANON_KEY=your-dev-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key
API_PORT=4000
API_CORS_ORIGIN=http://localhost:5173

# Optional placeholders (do not commit real values)
# PAYMENT_GATEWAY_SECRET=
# ENCRYPTION_KEY=
